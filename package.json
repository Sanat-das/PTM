{
  "name": "ptm",
  "version": "0.1.0",
  "description": "Search torrents, check YouTube reviews, watch it all in one app",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "PTM",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test \"src/**/*.test.ts\"",
    "predist": "node scripts/check-ffmpeg.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "fast-xml-parser": "^5.12.1",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.4",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^1.73.0",
    "magnet-uri": "^7.0.10",
    "parse-torrent": "^11.0.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.8",
    "undici": "^8.12.4",
    "webtorrent": "^3.0.21",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
